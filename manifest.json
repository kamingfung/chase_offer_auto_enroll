{
    "manifest_version": 3,
    "name": "Chase Offer Adder",
    "version": "1.1.1",
    "description": "Automatically adds available Chase Offers to your cards from the Chase Offers page.",
    "permissions": ["activeTab", "scripting", "notifications"],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "128": "images/icon128.png"
        }
    },
    "icons": {
        "128": "images/icon128.png"
    }
}
